# RAG-tutor backend configuration — copy to `.env` and fill in.
#
# HOW THE DEV<->PROD SWITCH WORKS: the code never changes between environments.
# Locally, this .env supplies localhost URLs. In production you set the SAME keys
# in the platform's env config with hosted URLs. Only the values differ. The
# values below are the LOCAL DEV defaults; prod notes are inline.
#
# NEVER put a real secret in this file — it is the only .env* variant that is
# tracked by git (see .gitignore).

# ---- Core -----------------------------------------------------------------
DEBUG=True                                   # prod: False (enables HTTPS/HSTS/secure cookies)
SECRET_KEY=change-me-to-a-long-random-string # prod: python -c "import secrets;print(secrets.token_urlsafe(64))"

# Comma-separated. REQUIRED when DEBUG=False — the app refuses to start without it.
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
# prod example: api.example.com,rag-tutor-api.internal

# Browser origins allowed to call the API. REQUIRED when DEBUG=False.
# localhost:3000 is added automatically ONLY when DEBUG=True — production never
# allows localhost implicitly.
CORS_ALLOWED_ORIGINS=
# prod example: https://your-frontend.vercel.app
# HTTPS origins that POST to Django (admin/session). Defaults to the https
# entries of CORS_ALLOWED_ORIGINS; set explicitly to add more.
CSRF_TRUSTED_ORIGINS=
# Force-redirect http->https in prod. Defaults True when DEBUG=False.
# /ping/ and /healthz are exempt so load-balancer probes never receive a 301.
SECURE_SSL_REDIRECT=True

# ---- Infra ----------------------------------------------------------------
# One Redis serves four roles: Celery broker, Celery result backend, Channels
# layer, and (when DEBUG=False) the Django cache backing DRF throttles and
# WebSocket tickets. REQUIRED when DEBUG=False.
REDIS_URL=redis://localhost:6379/0
# prod: a managed redis:// or rediss:// URL

# ---- Database (Postgres) --------------------------------------------------
SUPABASE_DB_HOST=
SUPABASE_DB_PORT=6543
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=
SUPABASE_DB_PASSWORD=

# ---- Object storage (S3-compatible) ---------------------------------------
# Today these point at Supabase Storage. For real AWS S3: leave
# AWS_S3_ENDPOINT_URL empty and set AWS_S3_REGION_NAME to the bucket's region.
SUPABASE_PROJECT_ID=
SUPABASE_REGION=
SUPABASE_BUCKET=media
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=media
AWS_S3_ENDPOINT_URL=
# prod (AWS S3): leave empty to use the native S3 endpoint
AWS_S3_REGION_NAME=

# ---- Vector DB ------------------------------------------------------------
# The index is created on first use with dimension=EMBEDDING_DIM. This MUST
# match the embedding model served at TEI_URL (bge-small-en-v1.5 -> 384).
PINECONE_API_KEY=
PINECONE_INDEX=studywise-documents
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1
EMBEDDING_DIM=384

# ---- LLM (OpenRouter — sole provider) -------------------------------------
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Optional model overrides. Defaults are set in accounts/ai_clients.py.
# Ultra does NOT support response_format — keep it for prose answers only.
OPENROUTER_ANSWER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
OPENROUTER_LLM_MODEL=nvidia/nemotron-3-super-120b-a12b:free

# ---- Embedding + rerank (TEI) — the dev<->prod switch point ----------------
# TWO separate TEI services. Embedding is a HARD dependency (ingestion and
# query both fail without it); reranking is SOFT (falls back to vector+keyword).
#   docker compose up            (backend/docker-compose.yml: both services)
# PROD: point these at your hosted TEI endpoints. Nothing else changes.
TEI_URL=http://localhost:8080/embed
TEI_TIMEOUT=10.0
RERANK_URL=http://localhost:8081/rerank
RERANK_TIMEOUT=10.0

# ---- Vision OCR (optional; local Ollama) ----------------------------------
# DEV: true, pointing at local Ollama. PROD: false (no Ollama host) — the
# text-layer + Tesseract fallback still handle most PDFs.
VISION_ENABLED=false
VISION_MODEL=minicpm-v
VISION_BASE_URL=http://localhost:11434/v1
