# RAG-tutor backend configuration — copy to `.env` and fill in.
#
# HOW THE DEV<->PROD SWITCH WORKS: the code never changes between environments.
# Locally, this .env supplies localhost URLs. In production you set the SAME keys
# in the platform dashboard (Render env vars) with hosted URLs. Only the values
# differ. The values below are the LOCAL DEV defaults; prod notes are inline.

# ---- Core -----------------------------------------------------------------
DEBUG=True                                   # prod: False (enables HTTPS/HSTS/secure cookies)
SECRET_KEY=change-me-to-a-long-random-string # prod: a fresh 50+ char secret (never reuse the dev one)

# Comma-separated. Add your prod hostnames in production.
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
# prod example: rag-tutor-api.onrender.com

# Extra browser origins allowed to call the API (base localhost:3000 is built in).
CORS_ALLOWED_ORIGINS=
# prod example: https://your-frontend.vercel.app
# HTTPS origins that POST to Django (admin/session). Usually same as CORS above.
CSRF_TRUSTED_ORIGINS=
# Force-redirect http->https in prod. Leave unset (defaults True when DEBUG=False).
# SECURE_SSL_REDIRECT=True

# ---- Infra ----------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0
# prod: an Upstash/managed redis:// URL (Celery broker + Channels layer)

# ---- Database (Supabase Postgres) -----------------------------------------
SUPABASE_DB_HOST=
SUPABASE_DB_PORT=6543
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=
SUPABASE_DB_PASSWORD=

# ---- Object storage (Supabase S3-compatible) ------------------------------
SUPABASE_PROJECT_ID=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=media
AWS_S3_ENDPOINT_URL=
AWS_S3_REGION_NAME=

# ---- Vector DB + LLM ------------------------------------------------------
PINECONE_API_KEY=
PINECONE_INDEX=studywise-documents
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1
EMBEDDING_DIM=384
GROQ_API_KEY=

# ---- Embedding + rerank (TEI) — the dev<->prod switch point ----------------
# DEV: run the TEI containers locally and leave these on localhost.
#   embed:  docker run -p 8080:80 ghcr.io/huggingface/text-embeddings-inference:cpu-latest --model-id BAAI/bge-small-en-v1.5
#   rerank: docker compose up   (backend/docker-compose.yml, port 8081)
# PROD: point these at your hosted TEI endpoints. Nothing else changes.
TEI_URL=http://localhost:8080/embed
TEI_TIMEOUT=10.0
RERANK_URL=http://localhost:8081/rerank
RERANK_TIMEOUT=10.0

# ---- Vision OCR (optional; local Ollama) ----------------------------------
# DEV: true, pointing at local Ollama. PROD: false (no Ollama host) — the
# text-layer + Tesseract fallback still handle most PDFs.
VISION_ENABLED=false
VISION_MODEL=minicpm-v
VISION_BASE_URL=http://localhost:11434/v1

# ---- Google OAuth ---------------------------------------------------------
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
