# RAG-tutor backend configuration — copy to `.env` and fill in.
#
# HOW THE DEV<->PROD SWITCH WORKS: the code never changes between environments.
# Locally, this .env supplies localhost URLs. In production you set the SAME keys
# in the platform's env config with hosted URLs. Only the values differ. The
# values below are the LOCAL DEV defaults; prod notes are inline.
#
# NEVER put a real secret in this file — it is the only .env* variant that is
# tracked by git (see .gitignore).

# ---- Core -----------------------------------------------------------------
DEBUG=True                                   # prod: False (enables HTTPS/HSTS/secure cookies)
SECRET_KEY=change-me-to-a-long-random-string # prod: python -c "import secrets;print(secrets.token_urlsafe(64))"

# Comma-separated. REQUIRED when DEBUG=False — the app refuses to start without it.
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
# prod example: api.example.com,rag-tutor-api.internal

# Browser origins allowed to call the API. REQUIRED when DEBUG=False.
# localhost:3000 is added automatically ONLY when DEBUG=True — production never
# allows localhost implicitly.
CORS_ALLOWED_ORIGINS=
# prod example: https://your-frontend.vercel.app
# HTTPS origins that POST to Django (admin/session). Defaults to the https
# entries of CORS_ALLOWED_ORIGINS; set explicitly to add more.
CSRF_TRUSTED_ORIGINS=
# Force-redirect http->https in prod. Defaults True when DEBUG=False.
# /ping/ and /healthz are exempt so load-balancer probes never receive a 301.
SECURE_SSL_REDIRECT=True

# ---- Infra ----------------------------------------------------------------
# One Redis serves four roles: Celery broker, Celery result backend, Channels
# layer, and (when DEBUG=False) the Django cache backing DRF throttles and
# WebSocket tickets. REQUIRED when DEBUG=False.
REDIS_URL=redis://localhost:6379/0
# prod: a managed redis:// or rediss:// URL

# ---- Database (Postgres) --------------------------------------------------
SUPABASE_DB_HOST=
SUPABASE_DB_PORT=6543
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=
SUPABASE_DB_PASSWORD=

# ---- Object storage (AWS S3) ----------------------------------------------
# Native AWS S3. There is no endpoint URL to set: boto3 derives the endpoint
# from the bucket and region, and the app uses virtual-hosted addressing with
# SigV4, both fixed in settings.py rather than configurable.
#
# THE BUCKET MUST BE PRIVATE. Keep Block Public Access enabled, add no
# public-read policy and no public ACLs. Reads are served as presigned URLs that
# expire after an hour, so nothing needs to be anonymously readable — and these
# are user documents, so nothing should be.
#
# The IAM user behind these credentials still needs s3:GetObject, s3:PutObject
# and s3:DeleteObject on the bucket. A private bucket restricts the public, not
# the application.
#
# All four are REQUIRED when DEBUG=False and the app refuses to boot without
# them. Leave them blank for local development and uploads fall back to the
# local filesystem (MEDIA_ROOT), so no AWS account is needed to run the app or
# the tests.
#
# The region must be the bucket's real region. There is no default, on purpose.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=

# ---- Vector DB ------------------------------------------------------------
# The index is created on first use with dimension=EMBEDDING_DIM. This MUST
# match the embedding model behind EMBEDDING_URL (bge-small-en-v1.5 -> 384).
# Changing the model means a NEW index and a full reindex — vectors from
# different models are not comparable even at identical dimensions.
PINECONE_API_KEY=
PINECONE_INDEX=studywise-documents
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1
EMBEDDING_DIM=384

# ---- LLM (OpenRouter — sole provider) -------------------------------------
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Optional model overrides. Defaults are set in accounts/ai_clients.py.
# Ultra does NOT support response_format — keep it for prose answers only.
OPENROUTER_ANSWER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
OPENROUTER_LLM_MODEL=nvidia/nemotron-3-super-120b-a12b:free

# ---- Embeddings — HARD dependency, the LEAN<->FULL switch point -----------
# The MODEL is fixed at BAAI/bge-small-en-v1.5 (384 dims). Only WHERE it runs
# changes between profiles, and switching is env-only — no code change.
#
# Required when DEBUG=False: the app refuses to start without EMBEDDING_URL,
# and without EMBEDDING_API_KEY for any provider other than `tei`.
#
# EMBEDDING_PROVIDER selects the request/response adapter:
#   tei         self-hosted TEI      {"inputs":[..]} -> [[..]]
#   cloudflare  Workers AI           {"text":[..]}   -> {"result":{"data":[[..]]}}
#   openai      OpenAI-compatible    {"input":[..]}  -> {"data":[{"embedding":[..]}]}
#
# ---- LEAN (managed; no inference container, runs on Graviton/arm64) --------
#   EMBEDDING_PROVIDER=cloudflare
#   EMBEDDING_URL=https://api.cloudflare.com/client/v4/accounts/<ACCOUNT_ID>/ai/run/@cf/baai/bge-small-en-v1.5
#   EMBEDDING_API_KEY=<cloudflare-api-token>        # REQUIRED
#   EMBEDDING_MODEL=@cf/baai/bge-small-en-v1.5
#   EMBEDDING_DIM=384
#   EMBEDDING_POOLING=cls                           # LEAVE THIS ALONE
#
# EMBEDDING_POOLING is the one setting that can corrupt retrieval without ever
# raising an error. bge-small-en-v1.5 is a CLS-pooled model and TEI honours that,
# so every vector in the Pinecone index is CLS-pooled — but Cloudflare Workers AI
# defaults to MEAN pooling. Measured on the same sentence against a local TEI:
#
#     pooling=cls    cosine 0.999999   <- same vector space, index reusable
#     pooling=mean   cosine 0.932247   <- incompatible; retrieval silently rots
#
# Both return 384 valid floats, so the dimension check cannot catch the wrong
# one. The client always sends this explicitly and rejects a response whose
# echoed pooling disagrees. Changing it means reindexing everything.
#
# ---- FULL (self-hosted TEI; docker compose --profile full up) --------------
#   EMBEDDING_PROVIDER=tei
#   EMBEDDING_URL=http://localhost:8080/embed      (compose: http://embedder:80/embed)
#   EMBEDDING_API_KEY=                              # not required — TEI is unauthenticated
#   EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
#   EMBEDDING_DIM=384
#
# Defaults below are the FULL/local-dev values.
EMBEDDING_PROVIDER=tei
EMBEDDING_URL=http://localhost:8080/embed
EMBEDDING_API_KEY=
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_TIMEOUT=10.0
# Sent to Cloudflare on every request; ignored by TEI, which reads pooling from
# the model config. See the note above before touching it.
EMBEDDING_POOLING=cls

# ---- Reranking — SOFT, and OFF unless set ---------------------------------
# UNSET = DISABLED. LEAN ships no reranker (bge-reranker-base needs ~5.5 GB
# RSS); the pipeline falls back to vector + keyword ordering. FULL sets this.
RERANK_URL=
RERANK_TIMEOUT=10.0

# ---- Vision OCR (optional; local Ollama) ----------------------------------
# DEV: true, pointing at local Ollama. PROD: false (no Ollama host) — the
# text-layer + Tesseract fallback still handle most PDFs.
VISION_ENABLED=false
VISION_MODEL=minicpm-v
VISION_BASE_URL=http://localhost:11434/v1
