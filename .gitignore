# Python
__pycache__/
*.pyc
*.pyo
*.pyd

# Environment — deny every .env variant, then re-allow the template.
# Catch-all so a new file (.env.local, .env.production, .env.staging, …) can
# never be accidentally tracked; only .env.example is meant to be committed.
.env
.env.*
!.env.example

# Virtual environments
venv/
.venv/

# Database
*.sqlite3

# Logs
*.log

# Huggingface / models
hf_cache/

# Uploaded RAG documents
[0-9a-f]*-[0-9a-f]*-[0-9a-f]*-[0-9a-f]*-[0-9a-f]*/

# Django generated
media/
staticfiles/

# OS
.DS_Store
Thumbs.db